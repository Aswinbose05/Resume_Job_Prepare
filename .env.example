# ==============================================================
# AI Career Intelligence Platform - Environment Variables
# ==============================================================

# Application Configuration
APP_NAME="AI Career Intelligence Platform"
APP_VERSION="2.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Primary LLM Provider (Options: gemini | groq | openrouter | portkey)
LLM_PROVIDER=gemini
FALLBACK_PROVIDER=groq

# Free LLM API Keys (At least one free provider key required)
GOOGLE_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Web Search Integration (Optional for live job/market insights)
SERPER_API_KEY=your_serper_api_key_here

# Portkey AI Gateway (Optional: provides gateway routing & guardrails)
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_VIRTUAL_KEY=your_portkey_virtual_key_here
PORTKEY_CONFIG_ID=

# LangSmith Observability (Optional: enables agent tracing & latency metrics)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=ai-career-intelligence
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Security Configuration
ENABLE_PROMPT_GUARD=true
ENABLE_SSRF_PROTECTION=true
ENABLE_PII_MASKING=true
ENABLE_RATE_LIMITING=true

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=15
RATE_LIMIT_BURST=25
